{
  "name": "shackle-host",
  "productName": "Shackle",
  "version": "1.1.0",
  "private": true,
  "description": "Shackle host: lets this computer be viewed and controlled through your own Shackle server",
  "author": "Silicode",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --x64 --publish never",
    "dist:mac": "electron-builder --mac --arm64 --x64 --publish never"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.silicode.shackle",
    "productName": "Shackle",
    "artifactName": "Shackle-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "shackle.config.json",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@nut-tree-fork/**/*",
      "**/*.node"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "shortcutName": "Shackle"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.utilities",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "Shackle shares this screen with people you allow to connect.",
        "NSAppleEventsUsageDescription": "Shackle controls the mouse and keyboard during a remote session."
      }
    },
    "afterPack": "scripts/after-pack.js"
  }
}
